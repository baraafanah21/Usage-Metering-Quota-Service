# Copy to .env. Docker Compose reads it for ${...} substitution, and `npm run dev`
# (in api/) loads it via --env-file. Tests ignore it (see api/vitest.config.ts).

# Used by `npm run dev` outside Docker. Compose sets its own DATABASE_URL for the api container.
# The compose `db` has no host port, so locally point at db-test (or your own Postgres).
DATABASE_URL=postgres://metering:metering@localhost:5433/metering_test

PORT=3000

# At least 32 characters. Generate one with: openssl rand -hex 32
ADMIN_API_KEY=replace-with-output-of-openssl-rand-hex-32

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Max connections in the pg pool.
DB_POOL_MAX=20
